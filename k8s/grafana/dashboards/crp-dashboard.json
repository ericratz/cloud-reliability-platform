{
  "uid": "crp-overview",
  "title": "CRP Observability",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Availability %",
      "targets": [
        {
          "expr": "1 - (sum(rate(crp_requests_total{status!~\"5..\"}[2m])) / clamp_min(sum(rate(crp_requests_total[2m])), 1))",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "targets": [
        {
          "expr": "sum(rate(crp_requests_total{status=~\"5..\"}[2m])) / clamp_min(sum(rate(crp_requests_total[2m])), 1)",
          "refId": "B"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 }
    },
    {
      "type": "timeseries",
      "title": "Latency p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(crp_request_duration_seconds_bucket[2m])) by (le))",
          "refId": "C"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 }
    }
  ]
}